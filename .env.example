# Path to the saved LinkedIn session cookies file
LINKEDIN_COOKIE_PATH=./data/session_cookies.json

# Set to false to watch browsers during scraping (useful for debugging)
LINKEDIN_HEADLESS=true

# Optional: LinkedIn credentials for automated login.
# If omitted, a headed browser will open for manual login.
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=

# Seconds to wait for manual login completion (default: 120)
LINKEDIN_LOGIN_TIMEOUT_SECONDS=120


# --- Supabase ---
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=
# Anon/public key (safe to expose in browser) — used by web server
SUPABASE_ANON_KEY=
# Service-role key (secret, write access) — used by scraper cron only
SUPABASE_SERVICE_ROLE_KEY=

# --- Web server auth ---
# Random string used to sign JWTs — generate with: openssl rand -hex 32
JWT_SECRET=
# Password to log in to the dashboard
DASHBOARD_PASSWORD=

# --- Web server ---
# HTTP port for the Express server (default: 3000)
PORT=3000